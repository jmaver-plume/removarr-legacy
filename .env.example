# Optional Configuration
# All environment variables are optional. The application will auto-generate
# secure defaults if not provided.

# Database path (optional, defaults to ./database.sqlite)
DB_PATH=./database.sqlite

# Server port (optional, defaults to 3000)
PORT=3000

# Session Secret (optional, auto-generated if not provided)
# For production, it's recommended to set this to a secure random string
SESSION_SECRET=change-this-to-a-secure-random-string

# ============================================================================
# APPLICATION SETTINGS - Stored in Database
# ============================================================================
# On first startup, the application will:
# 1. Create a settings table in the database
# 2. Generate admin credentials (username: removarr, random password)
# 3. Display the generated password in the console
#
# Configure the following via the settings API after first login:
# - Sonarr URL and API key
# - Radarr URL and API key
# - Voter names (at least 2 required)
#
# API endpoint: PUT /removarr/api/settings
# Or use the interactive CLI: npm run configure