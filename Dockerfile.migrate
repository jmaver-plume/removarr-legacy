# Temporary Dockerfile for running migration scripts
FROM node:24-slim

WORKDIR /app

# Install build dependencies for sqlite3
RUN apt-get update && \
    apt-get install -y python3 make g++ && \
    rm -rf /var/lib/apt/lists/*

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm install

# Copy scripts
COPY scripts ./scripts

# Default command runs migration
CMD ["npm", "run", "migrate"]
